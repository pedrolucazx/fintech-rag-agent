TELEGRAM_BOT_TOKEN=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# LLM_PROVIDER: nvidia (default) or gemini — which model answers the chat.
# NOT related to EMBEDDINGS_PROVIDER below; a model name like "voyage-4-large"
# is never valid here.
LLM_PROVIDER=nvidia
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# EMBEDDINGS_PROVIDER: xenova (default, local) or voyage — which model powers
# RAG retrieval. NOT related to LLM_PROVIDER above; "nvidia" is never valid here.
EMBEDDINGS_PROVIDER=xenova
VOYAGE_API_KEY=
REDIS_URL=redis://localhost:6379
