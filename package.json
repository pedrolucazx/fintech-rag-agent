{
  "name": "fintech-rag-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/bot.ts",
    "ingest": "tsx scripts/ingest.ts",
    "test": "tsx --test src/*.test.ts src/providers/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && swc src -d dist --strip-leading-paths --ignore \"**/*.test.ts\"",
    "start": "node dist/bot.js"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "openai": "^7.15.0",
    "vectra": "^0.15.0"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
